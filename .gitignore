# Secrets: never commit. Conductor copies them into workspaces via .worktreeinclude
.env
.env.*
!.env.example

# Agent scratch space and per-person settings
.context/
.claude/settings.local.json

# OS and tooling
.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/

# Builds and generated files
dist/
.expo/
expo-env.d.ts
*.tsbuildinfo
apps/mobile/ios/
apps/mobile/android/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Source folders named lib/ are code, even if a global gitignore says otherwise
!**/src/lib/

# ML: raw data, runs and checkpoints stay out of git (the exported model is committed)
ml/data/raw/
ml/data/mixtures/
ml/runs/
ml/checkpoints/
*.pt
ml/audio/inbox/*
!ml/audio/inbox/.gitkeep
ml/audio/private/*
!ml/audio/private/README.md
